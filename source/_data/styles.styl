body
  line-height 1.75

.site-meta
  display flex
  flex-wrap wrap
  align-items center
  justify-content center
  column-gap 10px

.brand
  padding-left 0
  padding-right 0

.site-title
  display inline

.site-subtitle
  display inline-block
  margin 0
  padding 2px 10px
  border 1px solid #1f6b56
  border-radius 999px
  background #1f6b56
  color #fffdf8
  font-size 12px
  letter-spacing 0.04em
  line-height 1.7
  vertical-align middle

.header-inner
  padding-top 72px

  +mobile()
    padding-top 36px

.content
  padding-top 40px

  +mobile()
    padding-top 24px

.post-body
  p
    margin 0 0 1.1em

  h1, h2, h3
    color #1b3330

  a
    text-underline-offset 0.18em

blockquote
  border-left-color #1f6b56
  background #f6f3ec
  padding 0.35em 1em

.menu-item a
  transition color 0.2s ease, border-color 0.2s ease

  &:hover
    color #1f6b56

.menu-item-active a
  border-bottom 2px solid #1f6b56

hr
  border 0
  border-top 1px solid #e4ddd2
  background none
  height 0
